# Telegram bot tokens (BotFather)
PM_BOT_TOKEN=
DEV_BOT_TOKEN=
QA_BOT_TOKEN=
DESIGNER_BOT_TOKEN=

# LLM provider keys
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Per-agent model override (defaults are set in settings.py)
PM_MODEL=claude-sonnet-4-6
DEV_MODEL=claude-opus-4-7
QA_MODEL=claude-sonnet-4-6
DESIGNER_MODEL=gpt-4o

# SQLite path (relative to project root)
DB_PATH=./data/memory.sqlite

# How many recent group messages to include in LLM context
HISTORY_LIMIT=20

# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
