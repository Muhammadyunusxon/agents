# Telegram bot tokens (BotFather)
PM_BOT_TOKEN=
DEV_BOT_TOKEN=
QA_BOT_TOKEN=
DESIGNER_BOT_TOKEN=

# LLM provider keys (fill in the ones matching the models you choose below)
# Gemini: https://aistudio.google.com/apikey  (free tier, no credit card)
GOOGLE_API_KEY=
# Anthropic Claude: https://console.anthropic.com  (paid, $5 min)
ANTHROPIC_API_KEY=
# OpenAI: https://platform.openai.com/api-keys  (paid)
OPENAI_API_KEY=

# Per-agent model. Provider is chosen by name prefix:
#   gemini-*  -> Google      (free)
#   claude-*  -> Anthropic   (paid)
#   gpt-*, o1-*, o3-*, o4-*  -> OpenAI (paid)
PM_MODEL=gemini-2.5-flash
DEV_MODEL=gemini-2.5-pro
QA_MODEL=gemini-2.5-flash
DESIGNER_MODEL=gemini-2.5-flash

# Memory backend: sqlite (default, local file) or postgres (e.g. Supabase)
DB_KIND=sqlite
DB_PATH=./data/memory.sqlite
DATABASE_URL=

# How many recent group messages to include in LLM context
HISTORY_LIMIT=20

# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
